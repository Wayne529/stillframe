{
  "name": "stillframe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json *.js",
    "lint": "eslint src tests *.ts"
  },
  "packageManager": "pnpm@9.12.3",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@noble/hashes": "^2.4.0",
    "@zip.js/zip.js": "^2.24.0",
    "comlink": "^4.4.2",
    "dexie": "^4.4.7",
    "exifreader": "^4.54.0",
    "immer": "^11.2.9",
    "konva": "^10.9.1",
    "lucide-react": "^1.70.0",
    "piexifjs": "^1.0.6",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "less": "^4.9.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.16"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
